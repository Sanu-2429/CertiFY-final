# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=certify

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Google OAuth (Gmail ingestion module wires this up fully) ---
GOOGLE_CLIENT_ID=250539304581-b07h396s0lnbrdunjbikmpilsabpmokf.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Microsoft OAuth (Outlook — added later, kept here so the shape exists) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# --- Encryption for stored OAuth refresh tokens ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=nrufyW1bmZIjf3vKHCr21YMwE-xIHkgid6VY0RKvTzk=

# --- Gmail ingestion (Module 3) ---
FRONTEND_URL=http://localhost:5173
GMAIL_POLL_INTERVAL_SECONDS=60
# Set to false in tests / when relying solely on the Pub/Sub push webhook
GMAIL_ENABLE_BACKGROUND_POLLER=true

# --- Blockchain anchoring (spec Phase 4 / Level 1) ---
# All three blank by default = feature fully inert, decision_engine.py
# falls straight through to Level 2 (see blockchain_service.py). See
# certify-blockchain/README.md and .env.example for how to get a Sepolia
# RPC URL + testnet wallet key and deploy the contract; paste the
# deployed address (printed by `npx hardhat run scripts/deploy.js
# --network sepolia`) below once you have it. Never commit real values.
SEPOLIA_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- Decentralized storage (spec section 24/26 — see ipfs_service.py) ---
# Both blank by default = feature inert, the Partner Institution portal's
# certificate-submission endpoint returns 503 rather than silently
# skipping encryption/storage. Get a free Pinata JWT at pinata.cloud
# (Developers -> API Keys -> New Key, give it pinFileToIPFS scope).
PINATA_JWT=
# A key DISTINCT from TOKEN_ENCRYPTION_KEY above - generate the same way:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CERTIFICATE_ENCRYPTION_KEY=

# --- Gemini API fallback (see app/services/gemini_client.py) ---
GEMINI_API_KEY=AQ.Ab8RN6KZdoRvfTh_zP5AfKPKegmlSG365oYC2s75-XqUEM28pw
